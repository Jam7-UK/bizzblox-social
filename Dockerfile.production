FROM node:22.22.1-bookworm-slim@sha256:4f77a690f2f8946ab16fe1e791a3ac0667ae1c3575c3e4d0d4589e9ed5bfaf3d AS build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends g++ make openssl python3 \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build:backend && pnpm build:orchestrator \
 && pnpm runtime:check \
 && pnpm --filter @bizzblox/social-runtime-dependencies deploy --prod /runtime

FROM node:22.22.1-bookworm-slim@sha256:4f77a690f2f8946ab16fe1e791a3ac0667ae1c3575c3e4d0d4589e9ed5bfaf3d AS runtime

ARG SOURCE_REVISION
ARG SOURCE_URL=https://github.com/Jam7-UK/bizzblox-social
ARG SERVICE_VERSION=1.47.0-bizzblox.1

LABEL org.opencontainers.image.title="BizzBLOX managed social service" \
      org.opencontainers.image.description="White-labelled exact-tenant social provider runtime" \
      org.opencontainers.image.source="$SOURCE_URL" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.version="$SERVICE_VERSION" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.documentation="$SOURCE_URL/tree/$SOURCE_REVISION"

RUN test "${#SOURCE_REVISION}" = 40 \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 bizzblox \
 && useradd --system --uid 10001 --gid 10001 --home-dir /app --shell /usr/sbin/nologin bizzblox \
 && mkdir -p /app/apps/backend /app/apps/orchestrator /app/prisma /app/scripts /tmp \
 && chown -R 10001:10001 /app /tmp

WORKDIR /app
COPY --from=build --chown=10001:10001 /runtime/node_modules ./node_modules
COPY --from=build --chown=10001:10001 /app/node_modules/.prisma/client ./node_modules/.prisma/client
COPY --from=build --chown=10001:10001 /app/apps/backend/dist ./apps/backend/dist
COPY --from=build --chown=10001:10001 /app/apps/orchestrator/dist ./apps/orchestrator/dist
COPY --from=build --chown=10001:10001 /app/libraries/nestjs-libraries/src/database/prisma/schema.prisma ./prisma/schema.prisma
COPY --from=build --chown=10001:10001 /app/scripts/bizzblox-managed-runtime-entry.mjs ./scripts/bizzblox-managed-runtime-entry.mjs

ENV NODE_ENV=production
USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--"]

FROM runtime AS api
CMD ["node", "scripts/bizzblox-managed-runtime-entry.mjs", "api"]

FROM runtime AS orchestrator
CMD ["node", "scripts/bizzblox-managed-runtime-entry.mjs", "orchestrator"]
